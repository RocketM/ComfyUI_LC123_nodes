e": "image_a", "name": "image_a", "type": "IMAGE", "link": 161}, {"label": "After", "localized_name": "image_b", "name": "image_b", "type": "IMAGE", "link": 165}, {"localized_name": "split_position", "name": "split_position", "type": "FLOAT", "widget": {"name": "split_position"}, "link": null}, {"localized_name": "show_divider", "name": "show_divider", "type": "BOOLEAN", "widget": {"name": "show_divider"}, "link": null}], "outputs": [{"localized_name": "split 🖼️", "name": "split 🖼️", "type": "IMAGE", "links": [163]}], "properties": {"cnr_id": "ComfyUI_LC123_nodes", "ver": "99a038649b8e60b85ac471e7b20718ee2180ae3e", "Node name for S&R": "LCImageSplit", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}}, "widgets_values": [0.5, true], "color": "#324B4B", "bgcolor": "#324B4B"}, {"id": 22, "type": "LayerUtility: ImageBlendAdvance", "pos": [660, 3260], "size": [430, 340], "flags": {"collapsed": false}, "order": 13, "mode": 0, "inputs": [{"localized_name": "background_image", "name": "background_image", "type": "IMAGE", "link": 102}, {"localized_name": "layer_image", "name": "layer_image", "type": "IMAGE", "link": 101}, {"localized_name": "layer_mask", "name": "layer_mask", "shape": 7, "type": "MASK", "link": 99}, {"localized_name": "invert_mask", "name": "invert_mask", "type": "BOOLEAN", "widget": {"name": "invert_mask"}, "link": null}, {"localized_name": "blend_mode", "name": "blend_mode", "type": "COMBO", "widget": {"name": "blend_mode"}, "link": null}, {"localized_name": "opacity", "name": "opacity", "type": "INT", "widget": {"name": "opacity"}, "link": null}, {"localized_name": "x_percent", "name": "x_percent", "type": "FLOAT", "widget": {"name": "x_percent"}, "link": null}, {"localized_name": "y_percent", "name": "y_percent", "type": "FLOAT", "widget": {"name": "y_percent"}, "link": null}, {"localized_name": "mirror", "name": "mirror", "type": "COMBO", "widget": {"name": "mirror"}, "link": null}, {"localized_name": "scale", "name": "scale", "type": "FLOAT", "widget": {"name": "scale"}, "link": null}, {"localized_name": "aspect_ratio", "name": "aspect_ratio", "type": "FLOAT", "widget": {"name": "aspect_ratio"}, "link": null}, {"localized_name": "rotate", "name": "rotate", "type": "FLOAT", "widget": {"name": "rotate"}, "link": null}, {"localized_name": "transform_method", "name": "transform_method", "type": "COMBO", "widget": {"name": "transform_method"}, "link": null}, {"localized_name": "anti_aliasing", "name": "anti_aliasing", "type": "INT", "widget": {"name": "anti_aliasing"}, "link": null}], "outputs": [{"localized_name": "image", "name": "image", "type": "IMAGE", "slot_index": 0, "links": [158]}, {"localized_name": "mask", "name": "mask", "type": "MASK", "links": null}], "properties": {"cnr_id": "comfyui_layerstyle", "ver": "2.0.38", "Node name for S&R": "LayerUtility: ImageBlendAdvance", "ue_properties": {"widget_ue_connectable": {"x_percent": true, "y_percent": true}, "version": "7.8", "input_ue_unconnectable": {}}, "enableTabs": false, "tabWidth": 65, "tabXOffset": 10, "hasSecondTab": false, "secondTabText": "Send Back", "secondTabOffset": 80, "secondTabWidth": 65}, "widgets_values": [false, "normal", 93, 50, 50, "None", 1, 1, 0, "lanczos", 16], "color": "#222", "bgcolor": "#000"}, {"id": 99, "type": "Label (rgthree)", "pos": [60, 2180], "size": [1048.095703125, 150], "flags": {"allow_interaction": true}, "order": 2, "mode": 0, "inputs": [], "outputs": [], "title": "Skin Beauty ✨", "properties": {"fontSize": 150, "fontFamily": "Arial", "fontColor": "#ffffff", "textAlign": "left", "backgroundColor": "transparent", "padding": 0, "borderRadius": 0, "angle": 0, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "enableTabs": false, "tabWidth": 65, "tabXOffset": 10, "hasSecondTab": false, "secondTabText": "Send Back", "secondTabOffset": 80, "secondTabWidth": 65}, "color": "#fff0", "bgcolor": "#fff0"}, {"id": 112, "type": "LCImageSplit", "pos": [1110, 3370], "size": [300, 420], "flags": {}, "order": 16, "mode": 0, "inputs": [{"label": "Before", "localized_name": "image_a", "name": "image_a", "type": "IMAGE", "link": 156}, {"label": "After", "localized_name": "image_b", "name": "image_b", "type": "IMAGE", "link": 158}, {"localized_name": "split_position", "name": "split_position", "type": "FLOAT", "widget": {"name": "split_position"}, "link": null}, {"localized_name": "show_divider", "name": "show_divider", "type": "BOOLEAN", "widget": {"name": "show_divider"}, "link": null}], "outputs": [{"localized_name": "split 🖼️", "name": "split 🖼️", "type": "IMAGE", "links": [159]}], "properties": {"cnr_id": "ComfyUI_LC123_nodes", "ver": "99a038649b8e60b85ac471e7b20718ee2180ae3e", "Node name for S&R": "LCImageSplit", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}}, "widgets_values": [0.5, true], "color": "#324B4B", "bgcolor": "#324B4B"}, {"id": 94, "type": "LCNote", "pos": [-1700, 2840], "size": [920, 1170], "flags": {}, "order": 3, "mode": 0, "inputs": [], "outputs": [], "properties": {"lc_note": {"source": "en", "texts": {"en": {"text": "# LC Skin Beauty ✨\n\nMask-aware skin cooling and brightening for ComfyUI (LC123). Works in **CIELAB** under an auto (or external) skin mask so backgrounds and most clothing stay out of the grade.\n\n---\n\n## Highlights\n\n- **Skin-first, not whole-frame bleach** — correction follows a skin probability mask  \n- **Presets that load the sliders** — pick a starting look, then fine-tune what you see  \n- **Eyes & lips protected** — auto mask soft-excludes dark eyes and strong lip red  \n- **Fabric-aware auto mask** — high local pattern variance is suppressed (prints/weaves)  \n- **Highlight & texture controls** — keep specular and pores from going plastic  \n- **Optional external MASK** — best quality when you already have a face/skin matte  \n- **On-node before/after wipe** — same LC image-FX preview style  \n- **Outputs** — graded `image` + `skin_mask` (inspect or reuse downstream)\n\n---\n\n## Features\n\n| Control | What it does |\n|--------|----------------|\n| **preset** | Starting point (Natural, Light, Fresh, Porcelain, Warm keep, Custom). Loads slider values; then sliders are source of truth. |\n| **strength** | How much of the effect to apply (0 = original, 1 = full, &gt;1 = stronger). |\n| **coolness** | Less yellow / cooler skin (LAB b*). |\n| **brightness** | Overall skin lift (whitening), softened on highlights. |\n| **rosy** | Pink/red flush (LAB a*). Negative = less red. |\n| **evenness** | Local color evening under the mask. |\n| **shadow_lift** | Extra lift in dark skin regions. |\n| **smooth** | Mild softening under the mask. |\n| **texture_preserve** | Caps how much smooth can flatten pores. |\n| **saturation** | Skin chroma under the mask (negative = quieter). |\n| **highlight_protect** | Reduce effect on bright specular skin. |\n| **mask_sensitivity** | Auto mask inclusiveness. |\n| **mask_feather** | Softness of mask edges. |\n| **mask** (optional) | External skin matte; blended with auto for precision. |\n\n---\n\n## Getting the most out of it\n\n| Goal | Suggested approach |\n|------|---------------------|\n| **Natural cleanup** | Preset **Natural**, strength **0.7–1.0**. Leave other sliders as loaded. |\n| **Subtle only** | **Light**, strength **0.5–0.8**. |\n| **Clearer / cooler** | **Fresh** or raise **coolness** slightly; keep **highlight_protect** high. |\n| **Strong studio look** | **Porcelain**, strength **≤1.0**; raise **texture_preserve** if it goes plastic. |\n| **Keep warmth** | **Warm keep**, or lower **coolness** and raise **rosy** a little. |\n| **Less eye/lip change** | Already protected in auto mask; if needed, lower **strength** or use an external mask that excludes eyes/mouth. |\n| **Prints still pick up** | Lower **mask_sensitivity**; inspect **skin_mask** output; or feed a real skin **MASK**. |\n| **Hands / body too weak** | Raise **mask_sensitivity** slightly, or paint/segment those areas into **mask**. |\n| **Plastic skin** | Lower **smooth**, raise **texture_preserve**, ease **evenness**. |\n| **Flat highlights** | Raise **highlight_protect**; ease **brightness**. |\n| **Quality check** | Preview **skin_mask** — white = affected, black = left alone. |\n\n---\n\n## Quick workflow\n\n1. Image → **LC Skin Beauty ✨**  \n2. Choose a **preset** (sliders update)  \n3. Queue once; use the **wipe** to compare  \n4. Adjust **strength** first, then one or two sliders  \n5. Optional: view **skin_mask**; optional: wire an external **MASK**  \n\n---\n\n## Honest limits\n\nAuto mask is **color + structure heuristics**, not a person segmenter. Ornate fabrics and warm bokeh can still leak a little. For critical work, pair with **SAM / face-parse / hand mask** on the **mask** input.\n\n---"}, "zh": {"text": "# LC Skin Beauty ✨\n\n适用于 ComfyUI (LC123) 的、基于遮罩的皮肤冷色调与提亮。在 **CIELAB** 下工作，使用自动（或外部）皮肤遮罩，让背景和大部分衣物不参与调色。\n\n---\n\n## 亮点\n\n- **以皮肤为先，不是整幅漂白** — 校正跟随皮肤概率遮罩\n- **预设会载入滑块** — 选一个起始风格，然后微调你看到的内容\n- **保护眼睛和嘴唇** — 自动遮罩会柔和地排除深色眼睛和浓重的唇红\n- **识别织物的自动遮罩** — 局部图案方差高的区域（印花/织纹）会被抑制\n- **高光和质感控制** — 防止镜面高光和毛孔变得塑料感\n- **可选外部 MASK** — 当你已有脸部/皮肤蒙版时质量最佳\n- **节点上的前后对比擦除** — 与 LC 图像特效相同的预览风格\n- **输出** — 调色后的 `image` + `skin_mask`（可检查或在下游复用）\n\n---\n\n## 功能\n\n| 控制项 | 作用 |\n|--------|----------------|\n| **preset** | 起始点（Natural、Light、Fresh、Porcelain、Warm keep、Custom）。载入滑块数值；之后以滑块为准。 |\n| **strength** | 应用多少效果（0 = 原图，1 = 完整，&gt;1 = 更强）。 |\n| **coolness** | 更少的黄色 / 更冷的皮肤 (LAB b*)。 |\n| **brightness** | 整体皮肤提亮（美白），在高光处会被减弱。 |\n| **rosy** | 粉红/泛红的红晕 (LAB a*)。负值 = 更少的红。 |\n| **evenness** | 遮罩下的局部颜色均匀化。 |\n| **shadow_lift** | 在较暗的皮肤区域额外提亮。 |\n| **smooth** | 遮罩下轻微柔化。 |\n| **texture_preserve** | 限制 smooth 能把毛孔抹平多少。 |\n| **saturation** | 遮罩下的皮肤色度（负值 = 更平静）。 |\n| **highlight_protect** | 减少对明亮的镜面高光皮肤的作用。 |\n| **mask_sensitivity** | 自动遮罩的包容程度。 |\n| **mask_feather** | 遮罩边缘的柔和程度。 |\n| **mask**（可选） | 外部皮肤蒙版；与自动遮罩混合以求精确。 |\n\n---\n\n## 如何发挥它的最大效果\n\n| 目标 | 建议做法 |\n|------|---------------------|\n| **自然清理** | 预设 **Natural**，strength **0.7–1.0**。其他滑块保持载入时的值。 |\n| **只要细微效果** | **Light**，strength **0.5–0.8**。 |\n| **更清透 / 更冷** | **Fresh**，或稍微提高 **coolness**；保持 **highlight_protect** 较高。 |\n| **浓烈的影棚风格** | **Porcelain**，strength **≤1.0**；如果变得塑料感，就提高 **texture_preserve**。 |\n| **保留暖色** | **Warm keep**，或降低 **coolness** 并稍微提高 **rosy**。 |\n| **减少眼睛/嘴唇的变化** | 自动遮罩里已经保护了；如有需要，降低 **strength**，或使用排除眼睛/嘴巴的外部遮罩。 |\n| **印花仍然被影响** | 降低 **mask_sensitivity**；检查 **skin_mask** 输出；或者接入真正的皮肤 **MASK**。 |\n| **手 / 身体效果太弱** | 稍微提高 **mask_sensitivity**，或把这些区域绘制/分割进 **mask**。 |\n| **塑料感皮肤** | 降低 **smooth**，提高 **texture_preserve**，放缓 **evenness**。 |\n| **高光发平** | 提高 **highlight_protect**；放缓 **brightness**。 |\n| **质量检查** | 预览 **skin_mask** — 白色 = 受影响，黑色 = 不受影响。 |\n\n---\n\n## 快速工作流\n\n1. Image → **LC Skin Beauty ✨**\n2. 选择一个 **preset**（滑块会更新）\n3. 运行一次；用 **wipe** 来对比\n4. 先调整 **strength**，再调一两个滑块\n5. 可选：查看 **skin_mask**；可选：接入外部 **MASK**\n\n---\n\n## 坦白的局限\n\n自动遮罩是**颜色 + 结构的启发式方法**，不是人物分割器。华丽的织物和暖色散景仍可能稍有渗入。对于关键作品，请在 **mask** 输入上搭配 **SAM / face-parse / hand mask**。\n\n---\n", "src": "458febd4", "srcTitle": ""}}, "titles": {}}}, "widgets_values": ["English ✏️", "# LC Skin Beauty ✨\n\nMask-aware skin cooling and brightening for ComfyUI (LC123). Works in **CIELAB** under an auto (or external) skin mask so backgrounds and most clothing stay out of the grade.\n\n---\n\n## Highlights\n\n- **Skin-first, not whole-frame bleach** — correction follows a skin probability mask  \n- **Presets that load the sliders** — pick a starting look, then fine-tune what you see  \n- **Eyes & lips protected** — auto mask soft-excludes dark eyes and strong lip red  \n- **Fabric-aware auto mask** — high local pattern variance is suppressed (prints/weaves)  \n- **Highlight & texture controls** — keep specular and pores from going plastic  \n- **Optional external MASK** — best quality when you already have a face/skin matte  \n- **On-node before/after wipe** — same LC image-FX preview style  \n- **Outputs** — graded `image` + `skin_mask` (inspect or reuse downstream)\n\n---\n\n## Features\n\n| Control | What it does |\n|--------|----------------|\n| **preset** | Starting point (Natural, Light, Fresh, Porcelain, Warm keep, Custom). Loads slider values; then sliders are source of truth. |\n| **strength** | How much of the effect to apply (0 = original, 1 = full, &gt;1 = stronger). |\n| **coolness** | Less yellow / cooler skin (LAB b*). |\n| **brightness** | Overall skin lift (whitening), softened on highlights. |\n| **rosy** | Pink/red flush (LAB a*). Negative = less red. |\n| **evenness** | Local color evening under the mask. |\n| **shadow_lift** | Extra lift in dark skin regions. |\n| **smooth** | Mild softening under the mask. |\n| **texture_preserve** | Caps how much smooth can flatten pores. |\n| **saturation** | Skin chroma under the mask (negative = quieter). |\n| **highlight_protect** | Reduce effect on bright specular skin. |\n| **mask_sensitivity** | Auto mask inclusiveness. |\n| **mask_feather** | Softness of mask edges. |\n| **mask** (optional) | External skin matte; blended with auto for precision. |\n\n---\n\n## Getting the most out of it\n\n| Goal | Suggested approach |\n|------|---------------------|\n| **Natural cleanup** | Preset **Natural**, strength **0.7–1.0**. Leave other sliders as loaded. |\n| **Subtle only** | **Light**, strength **0.5–0.8**. |\n| **Clearer / cooler** | **Fresh** or raise **coolness** slightly; keep **highlight_protect** high. |\n| **Strong studio look** | **Porcelain**, strength **≤1.0**; raise **texture_preserve** if it goes plastic. |\n| **Keep warmth** | **Warm keep**, or lower **coolness** and raise **rosy** a little. |\n| **Less eye/lip change** | Already protected in auto mask; if needed, lower **strength** or use an external mask that excludes eyes/mouth. |\n| **Prints still pick up** | Lower **mask_sensitivity**; inspect **skin_mask** output; or feed a real skin **MASK**. |\n| **Hands / body too weak** | Raise **mask_sensitivity** slightly, or paint/segment those areas into **mask**. |\n| **Plastic skin** | Lower **smooth**, raise **texture_preserve**, ease **evenness**. |\n| **Flat highlights** | Raise **highlight_protect**; ease **brightness**. |\n| **Quality check** | Preview **skin_mask** — white = affected, black = left alone. |\n\n---\n\n## Quick workflow\n\n1. Image → **LC Skin Beauty ✨**  \n2. Choose a **preset** (sliders update)  \n3. Queue once; use the **wipe** to compare  \n4. Adjust **strength** first, then one or two sliders  \n5. Optional: view **skin_mask**; optional: wire an external **MASK**  \n\n---\n\n## Honest limits\n\nAuto mask is **color + structure heuristics**, not a person segmenter. Ornate fabrics and warm bokeh can still leak a little. For critical work, pair with **SAM / face-parse / hand mask** on the **mask** input.\n\n---"], "color": "#2E3A46", "bgcolor": "#2E3A46"}, {"id": 116, "type": "PreviewImage", "pos": [1750, 2530], "size": [350, 440], "flags": {}, "order": 17, "mode": 0, "inputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "link": 164}], "outputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "links": null}], "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "Node name for S&R": "PreviewImage", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}}, "widgets_values": [], "color": "#233", "bgcolor": "#355"}, {"id": 118, "type": "SaveImage", "pos": [1750, 3370], "size": [350, 460], "flags": {}, "order": 19, "mode": 0, "inputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "link": 167}, {"localized_name": "filename_prefix", "name": "filename_prefix", "type": "STRING", "widget": {"name": "filename_prefix"}, "link": null}], "outputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "links": null}], "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "Node name for S&R": "SaveImage", 
{"id": "4afd9f9b-4b25-42e3-a1e5-f257c28aa85d", "revision": 0, "last_node_id": 119, "last_link_id": 168, "nodes": [{"id": 44, "type": "PreviewImage", "pos": [-100, 3350], "size": [430, 490], "flags": {}, "order": 9, "mode": 0, "inputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "link": 125}], "outputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "links": []}], "properties": {"cnr_id": "comfy-core", "ver": "0.19.1", "Node name for S&R": "PreviewImage", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}, "enableTabs": false, "tabWidth": 65, "tabXOffset": 10, "hasSecondTab": false, "secondTabText": "Send Back", "secondTabOffset": 80, "secondTabWidth": 65}, "widgets_values": [], "color": "#233", "bgcolor": "#355"}, {"id": 19, "type": "LayerMask: SegmentAnythingUltra V2", "pos": [-500, 3350], "size": [370, 380], "flags": {"collapsed": false}, "order": 7, "mode": 0, "inputs": [{"localized_name": "image", "name": "image", "type": "IMAGE", "link": 59}, {"localized_name": "sam_model", "name": "sam_model", "type": "COMBO", "widget": {"name": "sam_model"}, "link": null}, {"localized_name": "grounding_dino_model", "name": "grounding_dino_model", "type": "COMBO", "widget": {"name": "grounding_dino_model"}, "link": null}, {"localized_name": "threshold", "name": "threshold", "type": "FLOAT", "widget": {"name": "threshold"}, "link": null}, {"localized_name": "detail_method", "name": "detail_method", "type": "COMBO", "widget": {"name": "detail_method"}, "link": null}, {"localized_name": "detail_erode", "name": "detail_erode", "type": "INT", "widget": {"name": "detail_erode"}, "link": null}, {"localized_name": "detail_dilate", "name": "detail_dilate", "type": "INT", "widget": {"name": "detail_dilate"}, "link": null}, {"localized_name": "black_point", "name": "black_point", "type": "FLOAT", "widget": {"name": "black_point"}, "link": null}, {"localized_name": "white_point", "name": "white_point", "t
", "name": "scale", "type": "FLOAT", "widget": {"name": "scale"}, "link": null}, {"localized_name": "aspect_ratio", "name": "aspect_ratio", "type": "FLOAT", "widget": {"name": "aspect_ratio"}, "link": null}, {"localized_name": "rotate", "name": "rotate", "type": "FLOAT", "widget": {"name": "rotate"}, "link": null}, {"localized_name": "transform_method", "name": "transform_method", "type": "COMBO", "widget": {"name": "transform_method"}, "link": null}, {"localized_name": "anti_aliasing", "name": "anti_aliasing", "type": "INT", "widget": {"name": "anti_aliasing"}, "link": null}], "outputs": [{"localized_name": "image", "name": "image", "type": "IMAGE", "slot_index": 0, "links": [158]}, {"localized_name": "mask", "name": "mask", "type": "MASK", "links": null}], "properties": {"cnr_id": "comfyui_layerstyle", "ver": "2.0.38", "Node name for S&R": "LayerUtility: ImageBlendAdvance", "ue_properties": {"widget_ue_connectable": {"x_percent": true, "y_percent": true}, "version": "7.8", "input_ue_unconnectable": {}}, "enableTabs": false, "tabWidth": 65, "tabXOffset": 10, "hasSecondTab": false, "secondTabText": "Send Back", "secondTabOffset": 80, "secondTabWidth": 65}, "widgets_values": [false, "normal", 93, 50, 50, "None", 1, 1, 0, "lanczos", 16], "color": "#222", "bgcolor": "#000"}, {"id": 99, "type": "Label (rgthree)", "pos": [60, 2180], "size": [1048.095703125, 150], "flags": {"allow_interaction": true}, "order": 2, "mode": 0, "inputs": [], "outputs": [], "title": "Skin Beauty ✨", "properties": {"fontSize": 150, "fontFamily": "Arial", "fontColor": "#ffffff", "textAlign": "left", "backgroundColor": "transparent", "padding": 0, "borderRadius": 0, "angle": 0, "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.5.2"}, "enableTabs": false, "tabWidth": 65, "tabXOffset": 10, "hasSecondTab": false, "secondTabText": "Send Back", "secondTabOffset": 80, "secondTabWidth": 65}, "color": "#fff0", "bgcolor": "#fff0"}, {"id": 112, "type": "LCImageSplit", "pos": [1110, 3370], "size": [300, 420], "flags": {}, "order": 16, "mode": 0, "inputs": [{"label": "Before", "localized_name": "image_a", "name": "image_a", "type": "IMAGE", "link": 156}, {"label": "After", "localized_name": "image_b", "name": "image_b", "type": "IMAGE", "link": 158}, {"localized_name": "split_position", "name": "split_position", "type": "FLOAT", "widget": {"name": "split_position"}, "link": null}, {"localized_name": "show_divider", "name": "show_divider", "type": "BOOLEAN", "widget": {"name": "show_divider"}, "link": null}], "outputs": [{"localized_name": "split 🖼️", "name": "split 🖼️", "type": "IMAGE", "links": [159]}], "properties": {"cnr_id": "ComfyUI_LC123_nodes", "ver": "99a038649b8e60b85ac471e7b20718ee2180ae3e", "Node name for S&R": "LCImageSplit", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}}, "widgets_values": [0.5, true], "color": "#324B4B", "bgcolor": "#324B4B"}, {"id": 94, "type": "LCNote", "pos": [-1700, 2840], "size": [920, 1170], "flags": {}, "order": 3, "mode": 0, "inputs": [], "outputs": [], "properties": {"lc_note": {"source": "en", "texts": {"en": {"text": "# LC Skin Beauty ✨\n\nMask-aware skin cooling and brightening for ComfyUI (LC123). Works in **CIELAB** under an auto (or external) skin mask so backgrounds and most clothing stay out of the grade.\n\n---\n\n## Highlights\n\n- **Skin-first, not whole-frame bleach** — correction follows a skin probability mask  \n- **Presets that load the sliders** — pick a starting look, then fine-tune what you see  \n- **Eyes & lips protected** — auto mask soft-excludes dark eyes and strong lip red  \n- **Fabric-aware auto mask** — high local pattern variance is suppressed (prints/weaves)  \n- **Highlight & texture controls** — keep specular and pores from going plastic  \n- **Optional external MASK** — best quality when you already have a face/skin matte  \n- **On-node before/after wipe** — same LC image-FX preview style  \n- **Outputs** — graded `image` + `skin_mask` (inspect or reuse downstream)\n\n---\n\n## Features\n\n| Control | What it does |\n|--------|----------------|\n| **preset** | Starting point (Natural, Light, Fresh, Porcelain, Warm keep, Custom). Loads slider values; then sliders are source of truth. |\n| **strength** | How much of the effect to apply (0 = original, 1 = full, &gt;1 = stronger). |\n| **coolness** | Less yellow / cooler skin (LAB b*). |\n| **brightness** | Overall skin lift (whitening), softened on highlights. |\n| **rosy** | Pink/red flush (LAB a*). Negative = less red. |\n| **evenness** | Local color evening under the mask. |\n| **shadow_lift** | Extra lift in dark skin regions. |\n| **smooth** | Mild softening under the mask. |\n| **texture_preserve** | Caps how much smooth can flatten pores. |\n| **saturation** | Skin chroma under the mask (negative = quieter). |\n| **highlight_protect** | Reduce effect on bright specular skin. |\n| **mask_sensitivity** | Auto mask inclusiveness. |\n| **mask_feather** | Softness of mask edges. |\n| **mask** (optional) | External skin matte; blended with auto for precision. |\n\n---\n\n## Getting the most out of it\n\n| Goal | Suggested approach |\n|------|---------------------|\n| **Natural cleanup** | Preset **Natural**, strength **0.7–1.0**. Leave other sliders as loaded. |\n| **Subtle only** | **Light**, strength **0.5–0.8**. |\n| **Clearer / cooler** | **Fresh** or raise **coolness** slightly; keep **highlight_protect** high. |\n| **Strong studio look** | **Porcelain**, strength **≤1.0**; raise **texture_preserve** if it goes plastic. |\n| **Keep warmth** | **Warm keep**, or lower **coolness** and raise **rosy** a little. |\n| **Less eye/lip change** | Already protected in auto mask; if needed, lower **strength** or use an external mask that excludes eyes/mouth. |\n| **Prints still pick up** | Lower **mask_sensitivity**; inspect **skin_mask** output; or feed a real skin **MASK**. |\n| **Hands / body too weak** | Raise **mask_sensitivity** slightly, or paint/segment those areas into **mask**. |\n| **Plastic skin** | Lower **smooth**, raise **texture_preserve**, ease **evenness**. |\n| **Flat highlights** | Raise **highlight_protect**; ease **brightness**. |\n| **Quality check** | Preview **skin_mask** — white = affected, black = left alone. |\n\n---\n\n## Quick workflow\n\n1. Image → **LC Skin Beauty ✨**  \n2. Choose a **preset** (sliders update)  \n3. Queue once; use the **wipe** to compare  \n4. Adjust **strength** first, then one or two sliders  \n5. Optional: view **skin_mask**; optional: wire an external **MASK**  \n\n---\n\n## Honest limits\n\nAuto mask is **color + structure heuristics**, not a person segmenter. Ornate fabrics and warm bokeh can still leak a little. For critical work, pair with **SAM / face-parse / hand mask** on the **mask** input.\n\n---"}}, "titles": {}}}, "widgets_values": ["English ✏️", "# LC Skin Beauty ✨\n\nMask-aware skin cooling and brightening for ComfyUI (LC123). Works in **CIELAB** under an auto (or external) skin mask so backgrounds and most clothing stay out of the grade.\n\n---\n\n## Highlights\n\n- **Skin-first, not whole-frame bleach** — correction follows a skin probability mask  \n- **Presets that load the sliders** — pick a starting look, then fine-tune what you see  \n- **Eyes & lips protected** — auto mask soft-excludes dark eyes and strong lip red  \n- **Fabric-aware auto mask** — high local pattern variance is suppressed (prints/weaves)  \n- **Highlight & texture controls** — keep specular and pores from going plastic  \n- **Optional external MASK** — best quality when you already have a face/skin matte  \n- **On-node before/after wipe** — same LC image-FX preview style  \n- **Outputs** — graded `image` + `skin_mask` (inspect or reuse downstream)\n\n---\n\n## Features\n\n| Control | What it does |\n|--------|----------------|\n| **preset** | Starting point (Natural, Light, Fresh, Porcelain, Warm keep, Custom). Loads slider values; then sliders are source of truth. |\n| **strength** | How much of the effect to apply (0 = original, 1 = full, &gt;1 = stronger). |\n| **coolness** | Less yellow / cooler skin (LAB b*). |\n| **brightness** | Overall skin lift (whitening), softened on highlights. |\n| **rosy** | Pink/red flush (LAB a*). Negative = less red. |\n| **evenness** | Local color evening under the mask. |\n| **shadow_lift** | Extra lift in dark skin regions. |\n| **smooth** | Mild softening under the mask. |\n| **texture_preserve** | Caps how much smooth can flatten pores. |\n| **saturation** | Skin chroma under the mask (negative = quieter). |\n| **highlight_protect** | Reduce effect on bright specular skin. |\n| **mask_sensitivity** | Auto mask inclusiveness. |\n| **mask_feather** | Softness of mask edges. |\n| **mask** (optional) | External skin matte; blended with auto for precision. |\n\n---\n\n## Getting the most out of it\n\n| Goal | Suggested approach |\n|------|---------------------|\n| **Natural cleanup** | Preset **Natural**, strength **0.7–1.0**. Leave other sliders as loaded. |\n| **Subtle only** | **Light**, strength **0.5–0.8**. |\n| **Clearer / cooler** | **Fresh** or raise **coolness** slightly; keep **highlight_protect** high. |\n| **Strong studio look** | **Porcelain**, strength **≤1.0**; raise **texture_preserve** if it goes plastic. |\n| **Keep warmth** | **Warm keep**, or lower **coolness** and raise **rosy** a little. |\n| **Less eye/lip change** | Already protected in auto mask; if needed, lower **strength** or use an external mask that excludes eyes/mouth. |\n| **Prints still pick up** | Lower **mask_sensitivity**; inspect **skin_mask** output; or feed a real skin **MASK**. |\n| **Hands / body too weak** | Raise **mask_sensitivity** slightly, or paint/segment those areas into **mask**. |\n| **Plastic skin** | Lower **smooth**, raise **texture_preserve**, ease **evenness**. |\n| **Flat highlights** | Raise **highlight_protect**; ease **brightness**. |\n| **Quality check** | Preview **skin_mask** — white = affected, black = left alone. |\n\n---\n\n## Quick workflow\n\n1. Image → **LC Skin Beauty ✨**  \n2. Choose a **preset** (sliders update)  \n3. Queue once; use the **wipe** to compare  \n4. Adjust **strength** first, then one or two sliders  \n5. Optional: view **skin_mask**; optional: wire an external **MASK**  \n\n---\n\n## Honest limits\n\nAuto mask is **color + structure heuristics**, not a person segmenter. Ornate fabrics and warm bokeh can still leak a little. For critical work, pair with **SAM / face-parse / hand mask** on the **mask** input.\n\n---"], "color": "#2E3A46", "bgcolor": "#2E3A46"}, {"id": 116, "type": "PreviewImage", "pos": [1750, 2530], "size": [350, 440], "flags": {}, "order": 17, "mode": 0, "inputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "link": 164}], "outputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "links": null}], "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "Node name for S&R": "PreviewImage", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}}, "widgets_values": [], "color": "#233", "bgcolor": "#355"}, {"id": 118, "type": "SaveImage", "pos": [1750, 3370], "size": [350, 460], "flags": {}, "order": 19, "mode": 0, "inputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "link": 167}, {"localized_name": "filename_prefix", "name": "filename_prefix", "type": "STRING", "widget": {"name": "filename_prefix"}, "link": null}], "outputs": [{"localized_name": "images", "name": "images", "type": "IMAGE", "links": null}], "properties": {"cnr_id": "comfy-core", "ver": "0.31.0", "Node name for S&R": "SaveImage", "ue_properties": {"widget_ue_connectable": {}, "input_ue_unconnectable": {}, "version": "7.8"}}, "widgets_values": ["LC Skin Beauty"], "color": "#233", "bgcolor": "#355"}, {"id": 1, "type": "LoadImage", "pos": [-750, 2430], "size": [500, 730], "flags": {}, "order": 4, "mode": 0, "inputs": [{"localiz